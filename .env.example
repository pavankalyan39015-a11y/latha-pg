# Database connection string
# SQLite (default for local development):
DATABASE_URL=sqlite:///./pg_management.db
# To switch to PostgreSQL, simply uncomment and set your PostgreSQL credentials:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pg_database

# Server settings
API_TITLE=Paying Guest (PG) Management API
API_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security & CORS
CORS_ORIGINS=*
